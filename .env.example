# =====================================================
# Promotion Hub - Environment Configuration
# Copy this file to .env and fill in your credentials
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/promotion_hub
# Database schema name
DB_SCHEMA=promotion_hub

# =====================================================
# LINKEDIN CONFIGURATION
# =====================================================
# LinkedIn account email
LINKEDIN_USERNAME=your_email@example.com
# LinkedIn account password
LINKEDIN_PASSWORD=your_password_here
# Optional: LinkedIn company page ID for posting
LINKEDIN_COMPANY_ID=

# =====================================================
# TELEGRAM CONFIGURATION
# =====================================================
# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Telegram channel ID for publishing (format: -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890
# Telegram API ID (get from https://my.telegram.org/auth)
TELEGRAM_API_ID=your_api_id_here
# Telegram API Hash (get from https://my.telegram.org/auth)
TELEGRAM_API_HASH=your_api_hash_here

# =====================================================
# INSTAGRAM CONFIGURATION
# =====================================================
# Instagram account username (email or phone)
INSTAGRAM_USERNAME=your_email@example.com
# Instagram account password
INSTAGRAM_PASSWORD=your_password_here
# Instagram session (auto-saved, base64 encoded)
INSTAGRAM_SESSION=

# =====================================================
# APPLICATION SETTINGS
# =====================================================
# Debug mode (True for development, False for production)
DEBUG=False
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Log file path
LOG_FILE=logs/promotion_hub.log

# =====================================================
# SCHEDULER SETTINGS
# =====================================================
# Enable scheduler (True to start automatic jobs)
SCHEDULER_ENABLED=True
# Timezone for job scheduling
SCHEDULER_TIMEZONE=Europe/Berlin

# =====================================================
# WORK HOURS CONFIGURATION (Day/Night Mode)
# =====================================================
# Work hours start (24-hour format, 0-23)
# Invitations and publications only during these hours
WORK_HOURS_START=9
# Work hours end (24-hour format, 0-23)
WORK_HOURS_END=18
# Timezone for work hours (UTC, Europe/Berlin, etc.)
TIMEZONE=Europe/Berlin
# Enable work hours restriction (True to prevent night notifications)
WORK_HOURS_ENABLED=True

# =====================================================
# PUBLICATION SCHEDULE (Work Hours: 9-18)
# =====================================================
# Instagram: 3 publications per day during work hours
INSTAGRAM_POSTS_PER_DAY=3
# Telegram: 3 publications per day during work hours
TELEGRAM_POSTS_PER_DAY=3
# LinkedIn: 2 publications per day during work hours
LINKEDIN_POSTS_PER_DAY=2

# =====================================================
# INVITATION SETTINGS (Work Hours: 9-18)
# =====================================================
# Random delay between invitations (min-max seconds)
# Default: 180-300 = 3-5 minutes for natural behavior
INVITATION_DELAY_MIN=180
INVITATION_DELAY_MAX=300
# Use random message templates (True = select randomly from 5 variants)
USE_RANDOM_MESSAGES=True
# Number of message template variants available
MESSAGE_TEMPLATE_VARIANTS=5

# =====================================================
# CONTENT SETTINGS
# =====================================================
# Language for content generation (DE for German)
CONTENT_LANGUAGE=DE

# =====================================================
# DATABASE RETENTION & CLEANUP
# =====================================================
# How many days to keep published posts in database (prevents database bloat)
# After X days, published posts are automatically deleted via cleanup job
POST_RETENTION_DAYS=30
# Enable automatic cleanup of old published posts (recommended: True)
CLEANUP_ENABLED=True
# Time to run daily cleanup job (24-hour format, UTC)
CLEANUP_TIME=02:00

# =====================================================
# RATE LIMITING & SAFETY (Deprecated - Use WORK_HOURS settings)
# =====================================================
# Note: These settings are deprecated. Use WORK_HOURS_START/END and INVITATION_DELAY instead.
# Old follow/DM/invite delays are now handled by scheduler and invitation module.
# FOLLOW_DELAY_MIN=10
# FOLLOW_DELAY_MAX=20
# DM_DELAY_MIN=30
# DM_DELAY_MAX=60
# INVITE_DELAY_MIN=300
# INVITE_DELAY_MAX=600

# =====================================================
# SCORING CONFIGURATION
# =====================================================
# Score threshold for invitation (0.0-1.0)
SCORE_THRESHOLD_INVITE=0.6
# Score threshold for saving (0.0-1.0)
SCORE_THRESHOLD_SAVE=0.3
# Max invitations per lead per channel
MAX_INVITES_PER_LEAD=1
# Max invitations per lead per channel
MAX_INVITES_PER_LEAD=1

# =====================================================
# AI & CONTENT GENERATION APIs
# =====================================================
# OpenAI API key for content generation (get from https://platform.openai.com)
OPENAI_API_KEY=sk-...
# Gemini API key (alternative to OpenAI, get from https://ai.google.dev)
GEMINI_API_KEY=
# DALL-E API key for image generation
DALLE_API_KEY=
# Default AI provider (openai, gemini)
AI_PROVIDER=openai
# Model to use (gpt-4, gpt-3.5-turbo, gemini-pro, gemini-1.5-pro, etc.)
AI_MODEL=gpt-3.5-turbo
# Image generation model (dall-e-3, dall-e-2, etc.)
IMAGE_MODEL=dall-e-3
# Enable AI content generation (True/False) - Set to True when API keys configured
USE_AI_CONTENT=False
