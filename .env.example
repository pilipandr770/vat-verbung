# =====================================================
# Promotion Hub - Environment Configuration
# Copy this file to .env and fill in your credentials
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/promotion_hub
# Database schema name
DB_SCHEMA=promotion_hub

# =====================================================
# LINKEDIN CONFIGURATION
# =====================================================
# LinkedIn account email
LINKEDIN_USERNAME=your_email@example.com
# LinkedIn account password
LINKEDIN_PASSWORD=your_password_here
# Optional: LinkedIn company page ID for posting
LINKEDIN_COMPANY_ID=

# =====================================================
# TELEGRAM CONFIGURATION
# =====================================================
# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Telegram channel ID for publishing (format: -1001234567890)
TELEGRAM_CHANNEL_ID=-1001234567890

# =====================================================
# INSTAGRAM CONFIGURATION
# =====================================================
# Instagram account username (email or phone)
INSTAGRAM_USERNAME=your_email@example.com
# Instagram account password
INSTAGRAM_PASSWORD=your_password_here
# Instagram session (auto-saved, base64 encoded)
INSTAGRAM_SESSION=

# =====================================================
# APPLICATION SETTINGS
# =====================================================
# Debug mode (True for development, False for production)
DEBUG=False
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Log file path
LOG_FILE=logs/promotion_hub.log

# =====================================================
# SCHEDULER SETTINGS
# =====================================================
# Enable scheduler (True to start automatic jobs)
SCHEDULER_ENABLED=True
# Timezone for job scheduling
SCHEDULER_TIMEZONE=Europe/Berlin

# =====================================================
# CONTENT SETTINGS
# =====================================================
# Language for content generation (DE for German)
CONTENT_LANGUAGE=DE
# Max posts per day per channel
MAX_POSTS_PER_DAY=3

# =====================================================
# RATE LIMITING & SAFETY
# =====================================================
# Minimum delay between follows (seconds)
FOLLOW_DELAY_MIN=10
FOLLOW_DELAY_MAX=20
# Minimum delay between DMs (seconds)
DM_DELAY_MIN=30
DM_DELAY_MAX=60
# Minimum delay between invites (seconds)
INVITE_DELAY_MIN=300
INVITE_DELAY_MAX=600
# Max leads to process per job
MAX_LEADS_PER_JOB=50

# =====================================================
# SCORING CONFIGURATION
# =====================================================
# Score threshold for invitation (0.0-1.0)
SCORE_THRESHOLD_INVITE=0.6
# Score threshold for saving (0.0-1.0)
SCORE_THRESHOLD_SAVE=0.3
# Max invitations per lead per channel
MAX_INVITES_PER_LEAD=1
